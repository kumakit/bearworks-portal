{
  "name": "bearworks.uk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "validate:hachioji-climate": "node scripts/validate-hachioji-climate-bundle.mjs",
    "build": "npm run validate:hachioji-climate && next build",
    "cf:build": "npm run validate:hachioji-climate && opennextjs-cloudflare build",
    "preview": "npm run validate:hachioji-climate && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run validate:hachioji-climate && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run validate:hachioji-climate && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^0.378.0",
    "next": "16.3.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "esbuild": "0.27.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "4.114.0"
  }
}
